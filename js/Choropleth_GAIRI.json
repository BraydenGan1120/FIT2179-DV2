{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Choropleth Map of AI Readiness Index of the World",
    "width": 1000,
    "height": 500,
    "projection": {"type": "equalEarth"},
    "data": {
        "url": "maps/World.json",
        "format": {"type": "geojson"}
    },
    "transform": [
        {
            "lookup": "name",
            "from": {
                "data": {
                    "url": "data/2025-GAIRI-data-1.csv"
                },
                "key": "Country",
                "fields": ["Government AI Readiness Index"]
            }
        }
    ],
    "mark": {"type": "geoshape"}
}


