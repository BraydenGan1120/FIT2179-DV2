{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 800,
    "height": 500,
    "projection": {"type": "equalEarth", "scale": 180}, 
    "background": "#23395B",

    "config": {
        "view": {
            "stroke": "transparent"
        }
    },

    "data": {
        "url": "https://raw.githubusercontent.com/BraydenGan1120/FIT2179-DV2/main/maps/World.json",
        "format": {"type": "topojson", "feature": "World"}
    },

    "transform": [
        {
            "lookup": "properties.NAME",
            "from": {
                "data": {
                    "url": "https://raw.githubusercontent.com/BraydenGan1120/FIT2179-DV2/main/data/2025-GAIRI-data-1.csv"
                },
                "key": "Country",
                "fields": ["Total Score", "Rank"]
            }
        }
    ],
    
    "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.43},
    
    "encoding": {
        "color": {
            "field": "Total Score",
            "type": "quantitative",
            "scale": {"scheme": "oranges", "domain": [0, 100]},
            "legend": {"title": "AI Readiness Score"}
        },
            "tooltip": [
            {"field": "properties.NAME", "type": "nominal", "title": "Country"},
            {"field": "Total Score", "type": "quantitative", "title": "Total Score"},
            {"field": "Rank", "type": "quantitative", "title": "Rank"}
        ]
    }
}


