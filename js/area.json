  "params": [
    {
      "name": "CountrySelect",
      "select": {
        "type": "point",
        "fields": ["Country"]
      },
      "bind": "legend"
    }
  ],

  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.8
  },

  "encoding": {

    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "title": "Year",
        "labelColor": "white",
        "titleColor": "white",
        "grid": false
      }
    },

    "y": {
      "field": "Revenue",
      "type": "quantitative",
      "stack": "zero",
      "axis": {
        "title": "Market Size (USD Billion)",
        "labelColor": "white",
        "titleColor": "white",
        "grid": true,
        "gridColor": "#42557B",
        "gridOpacity": 0.4
      }
    },

    "color": {
      "field": "Country",
      "type": "nominal",
      "scale": {
        "domain": [
