          "United States",
          "China",
          "France"
        ],
        "scheme": "oranges"
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "horizontal",
        "labelColor": "white",
        "symbolType": "square"
      }
    },

    "opacity": {
      "condition": {
        "param": "CountrySelect",
        "value": 1
      },
      "value": 0.25
    },

    "tooltip": [
      {
        "field": "Country",
        "title": "Country"
      },
      {
        "field": "Year",
        "title": "Year"
      },
      {
        "field": "Revenue",
        "title": "Market Size (USD B)",
        "format": ".2f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Akt, sans-serif",
