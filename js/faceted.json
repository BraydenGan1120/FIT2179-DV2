    "facet": {
        "column": {
            "field": "Cohort",
            "title": null,
            "header": {
                "labelColor": "#CBF7ED",
                "labelFontSize": 13,
                "labelFontWeight": "bold",
                "labelFont": "Inter, Arial, sans-serif"
            }
        }
    },

    "spec": {
        "width": 270,
        "height": 300,

        "layer": [
            {
                "description": "Lollipop stem - rule from 0 to Share using data coordinates",
                "mark": {

                    "type": "rule",
                    "strokeWidth": 2,
                    "color": "orange"
                },
                "encoding": {
                    "x": {
                        "field": "ShareZero",
                        "type": "quantitative"
                    },
                    "x2": {
                        "field": "Share"
                    },
                    "y": {
                        "field": "Occupation",
                        "type": "nominal",
                        "sort": "-x",
                        "axis": {
                            "title": "Occupation", 
                            "titleColor": "#8EA8C3",
                            "titleFontSize": 11,
                            "labelColor": "white",
                            "gridColor": "grey",
                            "tickColor": "grey",
                            "domainColor": "grey"
                        }
                    }
                }
            },

        {
            "description": "Lollipop head - point at Share value",
            "mark": {
                "type": "point",
                "filled": true,
                "size": 100,
                "strokeWidth": 1,
                "stroke": "#ffffff",
                "opacity": 1
            },
            "encoding": {
                "x": {
                    "field": "Share",
                    "type": "quantitative",
                    "scale": {"zero": true},
                    "axis": {
                        "title": "Share of Cohort Workforce (%)",
                        "titleColor": "#8EA8C3",
                        "titleFontSize": 11,
                        "labelColor": "white",
                        "gridColor": "grey",
                        "tickColor": "grey",
                        "domainColor": "grey"
                    }
                },
                "y": {
                    "field": "Occupation",
                    "type": "nominal",
                    "sort": "-x",
                    "axis": {
                        "title": "Occupation", 
                        "titleColor": "#8EA8C3",
                        "titleFontSize": 11,
                        "labelColor": "white",
                        "gridColor": "grey",
                        "tickColor": "grey",
                        "domainColor": "grey"
                    }
                },
                "color": {
                    "field": "Augmentation",
                    "type": "nominal",
                    "scale": {
                        "domain": ["Low", "Medium", "High"],
                        "range": ["#8EA8C3", "#F2A65A", "#CBF7ED"]
                    },
                    "legend": {
                        "title": "AI Augmentation",
                        "orient": "bottom",
                        "direction": "vertical",
                        "labelColor": "#ffffff",
                        "titleColor": "#CBF7ED",
                        "labelFont": "Inter, Arial, sans-serif",
                        "titleFont": "Inter, Arial, sans-serif",
                        "labelFontSize": 11,
                        "symbolType": "circle",
                        "symbolSize": 100
                    }
                },
                "shape": {
                    "field": "Automation",
                    "type": "nominal",
                    "scale": {
                        "domain": ["Very Low", "Low", "Medium", "High"],
                        "range": ["circle", "square", "diamond", "triangle-up"]
                    },
                    "legend": {
                        "title": "Automation Exposure",
                        "orient": "bottom",
                        "direction": "vertical",
                        "labelColor": "#ffffff",
                        "titleColor": "#CBF7ED",
                        "labelFont": "Inter, Arial, sans-serif",
                        "titleFont": "Inter, Arial, sans-serif",
                        "labelFontSize": 11,
                        "symbolSize": 100
                    }
                },
                "tooltip": [
                    {"field": "Occupation", "title": "Occupation"},
                    {"field": "Cohort", "title": "Cohort"},
                    {"field": "Share", "title": "Workforce Share (%)", "format": ".1f"},
                    {"field": "Augmentation", "title": "AI Augmentation"},
                    {"field": "Automation", "title": "Automation Exposure"}
                ]
            }
        }
        ]
    },

    "transform": [
        {
        "calculate": "0",
        "as": "ShareZero"
        }
    ],

    "resolve": {
        "scale": {
        "x": "independent",
        "y": "independent"
        }
    },

    "config": {
        "view": {"stroke": null},
        "axis": {"grid": true},
        "legend": {
        "labelColor": "#ffffff",
        "titleColor": "#CBF7ED"
        }
    }
}